    {"src":"./noor-calendar-512-maskable-v2.png","sizes":"512x512","type":"image/png","purpose":"maskable"},
    {"src":"./noor-calendar-v2.svg","sizes":"any","type":"image/svg+xml","purpose":"any"}
  ]
